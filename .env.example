IG_USER_ID=""
IG_ACCESS_TOKEN=""
GRAPH_VERSION="v25.0"
IG_API_HOST="graph.instagram.com"

# Optional: cross-post feed posts to Threads (separate API + separate token —
# the IG token does NOT work here). Leave blank to disable. Feed posts only;
# Threads has no stories. Token scopes: threads_basic + threads_content_publish.
THREADS_USER_ID=""
THREADS_ACCESS_TOKEN=""

# Pick one image host. Cloudinary is recommended for full automation.
IMAGE_HOST="cloudinary"
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_UPLOAD_PRESET=""
# Or, for signed Cloudinary uploads:
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
CLOUDINARY_FOLDER="shorts-creation/instagram-auto"

# Dropbox alternative. Needs a Dropbox API access token with files/content/write and sharing/write.
DROPBOX_ACCESS_TOKEN=""
DROPBOX_FOLDER="/Instagram Auto Posts"
